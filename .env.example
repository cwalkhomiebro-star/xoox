# ── Telegram Bots ──────────────────────────────────────────────────────────────
# Main bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUvwXYZ

# Admin Telegram ID (from @userinfobot)
ADMIN_ID=123456789

# Private Channel ID (e.g., -100123456789)
CHANNEL_ID=-1001234567890

# Payment Wallet Address (USDT TRC20)
USDT_TRC20_WALLET=your_trc20_wallet_address_here

# Support Telegram Username (without @)
SUPPORT_USERNAME=YourSupportUsername

# Bot Username (without @) — needed for referral links
BOT_USERNAME=YourBotUsername

# Cashier Bot Token (from @BotFather)
CASHIER_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUvwXYZ

# Cashier Bot Username (without @)
CASHIER_BOT_USERNAME=YourCashierBotUsername

# ── Vercel Webhook Security ────────────────────────────────────────────────────
# A secret string you choose — must match what you set in Vercel's env vars.
# Telegram will send this in the X-Telegram-Bot-Api-Secret-Token header.
WEBHOOK_SECRET=change-this-to-a-random-secret

# ── Turso Database (Free — no credit card needed) ──────────────────────────────
# Sign up at https://turso.tech, create a database, then paste the values below.
# Get these from: turso db show <your-db-name> && turso db tokens create <your-db-name>
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here
